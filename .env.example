# Copia este archivo como .env (o pon estas variables en Render) y rellénalas. No subas nunca el .env con valores reales.
BASE_URL=https://tu-dominio
SESSION_SECRET=
PORT=3000
# Base de datos del servidor de SA-MP
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_POOL=5
MYSQL_SSL=
# Discord (Developer Portal -> OAuth2): añadir la redirección https://tu-dominio/auth/discord/callback.
# Se usa para la verificación del Discord (/verificar): el bot da el rol y el apodo al ver el enlace nuevo.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Opcional: captcha de Cloudflare Turnstile en el inicio de sesión y el contacto
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
SERVER_IP=
POST_MIN_LEVEL=5
